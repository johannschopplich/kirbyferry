{
  "name": "kirbyferry",
  "type": "module",
  "version": "0.3.0",
  "packageManager": "pnpm@12.23.0",
  "description": "Round-trip Kirby blocks/layout fields to editable JSON and back",
  "author": "Johann Schopplich <hello@johannschopplich.com>",
  "license": "MIT",
  "homepage": "https://github.com/johannschopplich/kirbyferry#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johannschopplich/kirbyferry.git"
  },
  "bugs": {
    "url": "https://github.com/johannschopplich/kirbyferry/issues"
  },
  "keywords": [
    "kirby",
    "kirby-cms",
    "getkirby",
    "cli",
    "json"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "types": "./dist/index.d.mts",
  "bin": {
    "kirbyferry": "bin/kirbyferry.mjs"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "dev": "node src/entry.ts",
    "build": "tsdown",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "test:types": "tsc --noEmit",
    "release": "bumpp"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@types/node": "^26.6.11",
    "bumpp": "^12.3.0",
    "eslint": "^10.15.0",
    "eslint-flat-config-utils": "^3.2.0",
    "fast-check": "^4.11.0",
    "tsdown": "^0.23.7",
    "typescript": "^6.0.3",
    "utilful": "^3.6.1",
    "vitest": "^5.1.2"
  }
}
